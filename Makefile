programs/winefile/all: programs/winefile/winefile.man programs/winefile/i386-windows/winefile.exe
programs/winefile/install programs/winefile/install-lib:: programs/winefile/winefile.man \
  programs/winefile/i386-windows/winefile.exe tools/wineapploader
	tools/install-sh -m 644 $(INSTALL_DATA_FLAGS) programs/winefile/winefile.man $(DESTDIR)$(mandir)/man1/winefile.1
	STRIPPROG=i686-w64-mingw32-strip tools/install-sh -m 644 $(INSTALL_PROGRAM_FLAGS) programs/winefile/i386-windows/winefile.exe $(DESTDIR)$(libdir)/wine/i386-windows/winefile.exe
	tools/winebuild/winebuild --builtin $(DESTDIR)$(libdir)/wine/i386-windows/winefile.exe
	tools/install-sh $(INSTALL_SCRIPT_FLAGS) tools/wineapploader $(DESTDIR)$(bindir)/winefile
programs/winefile/clean::
	rm -f programs/winefile/winefile.res programs/winefile/winefile.man \
  programs/winefile/i386-windows/winefile.o programs/winefile/i386-windows/winefile.exe \
  programs/winefile/winefile.pot
programs/winemenubuilder/i386-windows/winemenubuilder.o: programs/winemenubuilder/winemenubuilder.c
	$(i386_CC) -c -o $@ programs/winemenubuilder/winemenubuilder.c -Iprograms/winemenubuilder -Iinclude \
  -Iinclude/msvcrt -D__WINESRC__ -D_UCRT -D__WINE_PE_BUILD -Wall -fno-strict-aliasing \
  -Wdeclaration-after-statement -Wempty-body -Wignored-qualifiers -Winit-self \
  -Wno-packed-not-aligned -Wshift-overflow=2 -Wstrict-prototypes -Wtype-limits \
  -Wunused-but-set-parameter -Wvla -Wwrite-strings -Wpointer-arith -Wlogical-op -Wabsolute-value \
  -ffunction-sections -Wno-misleading-indentation -fno-omit-frame-pointer \
  -mpreferred-stack-boundary=2 -gdwarf-4 $(i386_CFLAGS)
