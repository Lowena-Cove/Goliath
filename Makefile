  dlls/ws2_32/ws2_32.so
	STRIPPROG=i686-w64-mingw32-strip tools/install-sh -m 644 $(INSTALL_PROGRAM_FLAGS) dlls/ws2_32/i386-windows/ws2_32.dll $(DESTDIR)$(libdir)/wine/i386-windows/ws2_32.dll
	tools/winebuild/winebuild --builtin $(DESTDIR)$(libdir)/wine/i386-windows/ws2_32.dll
