programs/findstr/i386-windows/findstr.exe: programs/findstr/i386-windows/main.o \
  programs/findstr/findstr.res dlls/user32/i386-windows/libuser32.a \
  dlls/winecrt0/i386-windows/libwinecrt0.a dlls/ucrtbase/i386-windows/libucrtbase.a \
  dlls/kernel32/i386-windows/libkernel32.a dlls/ntdll/i386-windows/libntdll.a \
  tools/winebuild/winebuild tools/winegcc/winegcc
	tools/winegcc/winegcc -o $@ --wine-objdir . -b i686-w64-mingw32 -Wl,--wine-builtin -mconsole \
  -municode -mno-cygwin programs/findstr/i386-windows/main.o programs/findstr/findstr.res \
  dlls/user32/i386-windows/libuser32.a dlls/winecrt0/i386-windows/libwinecrt0.a \
  dlls/ucrtbase/i386-windows/libucrtbase.a dlls/kernel32/i386-windows/libkernel32.a \
  dlls/ntdll/i386-windows/libntdll.a $(i386_LDFLAGS)
programs/findstr/all: programs/findstr/i386-windows/findstr.exe
programs/findstr/install programs/findstr/install-lib:: programs/findstr/i386-windows/findstr.exe
	STRIPPROG=i686-w64-mingw32-strip tools/install-sh -m 644 $(INSTALL_PROGRAM_FLAGS) programs/findstr/i386-windows/findstr.exe $(DESTDIR)$(libdir)/wine/i386-windows/findstr.exe
	tools/winebuild/winebuild --builtin $(DESTDIR)$(libdir)/wine/i386-windows/findstr.exe
