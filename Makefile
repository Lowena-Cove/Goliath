	tools/install-sh -m 644 $(INSTALL_DATA_FLAGS) tools/widl/widl.man $(DESTDIR)$(mandir)/man1/widl.1
	STRIPPROG="$(STRIP)" tools/install-sh $(INSTALL_PROGRAM_FLAGS) tools/widl/widl $(DESTDIR)$(bindir)/widl
