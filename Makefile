  dlls/shell32/i386-windows/libshell32.a dlls/comdlg32/i386-windows/libcomdlg32.a \
  dlls/comctl32/i386-windows/libcomctl32.a dlls/ole32/i386-windows/libole32.a \
  dlls/mpr/i386-windows/libmpr.a dlls/version/i386-windows/libversion.a \
  dlls/user32/i386-windows/libuser32.a dlls/gdi32/i386-windows/libgdi32.a \
  dlls/advapi32/i386-windows/libadvapi32.a dlls/shlwapi/i386-windows/libshlwapi.a \
  dlls/winecrt0/i386-windows/libwinecrt0.a dlls/ucrtbase/i386-windows/libucrtbase.a \
  dlls/kernel32/i386-windows/libkernel32.a dlls/ntdll/i386-windows/libntdll.a \
  tools/winebuild/winebuild tools/winegcc/winegcc
	tools/winegcc/winegcc -o $@ --wine-objdir . -b i686-w64-mingw32 -Wl,--wine-builtin -mwindows \
  -municode -mno-cygwin programs/winefile/i386-windows/winefile.o programs/winefile/winefile.res \
  libs/uuid/i386-windows/libuuid.a dlls/shell32/i386-windows/libshell32.a \
  dlls/comdlg32/i386-windows/libcomdlg32.a dlls/comctl32/i386-windows/libcomctl32.a \
  dlls/ole32/i386-windows/libole32.a dlls/mpr/i386-windows/libmpr.a \
