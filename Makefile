dlls/winebus.sys/install dlls/winebus.sys/install-lib:: dlls/winebus.sys/i386-windows/winebus.sys \
  dlls/winebus.sys/winebus.so
	STRIPPROG=i686-w64-mingw32-strip tools/install-sh -m 644 $(INSTALL_PROGRAM_FLAGS) dlls/winebus.sys/i386-windows/winebus.sys $(DESTDIR)$(libdir)/wine/i386-windows/winebus.sys
	tools/winebuild/winebuild --builtin $(DESTDIR)$(libdir)/wine/i386-windows/winebus.sys
	STRIPPROG="$(STRIP)" tools/install-sh $(INSTALL_PROGRAM_FLAGS) dlls/winebus.sys/winebus.so $(DESTDIR)$(libdir)/wine/i386-unix/winebus.so
