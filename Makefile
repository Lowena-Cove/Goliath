dlls/ntdsapi/i386-windows/ntdsapi.o: dlls/ntdsapi/ntdsapi.c
	$(i386_CC) -c -o $@ dlls/ntdsapi/ntdsapi.c -Idlls/ntdsapi -Iinclude -Iinclude/msvcrt -D__WINESRC__ \
  -D_UCRT -D__WINE_PE_BUILD -Wall -fno-strict-aliasing -Wdeclaration-after-statement -Wempty-body \
  -Wignored-qualifiers -Winit-self -Wno-packed-not-aligned -Wshift-overflow=2 -Wstrict-prototypes \
  -Wtype-limits -Wunused-but-set-parameter -Wvla -Wwrite-strings -Wpointer-arith -Wlogical-op \
  -Wabsolute-value -ffunction-sections -Wno-misleading-indentation -fno-omit-frame-pointer \
  -mpreferred-stack-boundary=2 -gdwarf-4 $(i386_CFLAGS)
